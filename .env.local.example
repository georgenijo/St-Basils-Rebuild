# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_WEBHOOK_SECRET=

# Site
NEXT_PUBLIC_SITE_URL=

# Status page (BetterStack) — public URL; gates the footer "System Status" link.
# Leave empty until the status page + DNS are live.
NEXT_PUBLIC_STATUS_PAGE_URL=

# Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend
RESEND_API_KEY=

# Website change requests — who is emailed when an admin submits a request
# (comma-separated). Leave empty to skip the notification.
CHANGE_REQUEST_NOTIFY_EMAIL=

# Structured logging
LOG_LEVEL=

# CI / test support
EMAIL_TRANSPORT=
EMAIL_SINK_DIR=
E2E_MODE=
TEST_SUPPORT_ENABLED=
TEST_SUPPORT_SECRET=
ALLOW_TURNSTILE_TEST_BYPASS=
NEXT_PUBLIC_ALLOW_TURNSTILE_TEST_BYPASS=
TURNSTILE_TEST_BYPASS_TOKEN=
NEXT_PUBLIC_TURNSTILE_TEST_BYPASS_TOKEN=

# Vercel
# Server-only access for Admin > Logs. VERCEL_PROJECT_ID is automatically
# supplied in hosted deployments; set it locally only when testing the viewer.
VERCEL_ACCESS_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Required in Vercel Production. Without it, the daily
# /api/cron/dues-reminders job silently returns 401 forever.
CRON_SECRET=
VERCEL_AUTOMATION_BYPASS_SECRET=

# Local development admin bypass only. Never enable DEV_ADMIN_BYPASS in production.
DEV_ADMIN_BYPASS=
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
